{
  app: {
    products: [
      {
        name: 'default',
        compatibleSdkVersion: '5.0.0(12)',
        runtimeOS: 'HarmonyOS',
        targetSdkVersion: '26.0.0',
        buildOption: {
          strictMode: {
            useNormalizedOHMUrl: true,
          },
        },
      },
    ],
    signingConfigs: [],
    capabilities: [
      {
        bundleName: 'com.flyfish.account_app',
        config: [],
      },
    ],
  },
  modules: [
    {
      name: 'entry',
      srcPath: './entry',
      targets: [
        {
          name: 'default',
          applyToProducts: [
            'default',
          ],
        },
      ],
    },
  ],
}
